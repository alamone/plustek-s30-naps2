<Window x:Class="ScanKiosk.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Scan Kiosk" Width="1500" Height="1000"
        Background="{StaticResource Bg}"
        Stylus.IsPressAndHoldEnabled="False"
        Stylus.IsFlicksEnabled="False"
        UseLayoutRounding="True">
    <Grid x:Name="Root" Background="{StaticResource Bg}">

        <!-- ============================== HOME ============================== -->
        <Grid x:Name="HomeView" Margin="48,36,48,36">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <DockPanel Grid.Row="0" Margin="18,0,18,10">
                <Border DockPanel.Dock="Right" CornerRadius="30" Background="{StaticResource Panel}" Padding="26,12" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="StatusDot" Width="22" Height="22" Fill="{StaticResource Muted}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="StatusText" Text="Checking scanner…" FontSize="26" Margin="14,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <TextBlock Text="Choose how to scan" FontSize="54" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </DockPanel>

            <ItemsControl x:Name="Tiles" Grid.Row="1">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource TileButton}" Click="Tile_Click" Tag="{Binding}"
                                BorderBrush="{Binding Border}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" HorizontalAlignment="Left" CornerRadius="18" Padding="18,6"
                                        Background="{StaticResource Accent}" Visibility="{Binding BadgeVisibility}">
                                    <TextBlock Text="● SCAN BUTTON" FontSize="22" FontWeight="Bold"/>
                                </Border>
                                <!-- document icon -->
                                <Viewbox Grid.Row="1" Margin="40,30" MaxHeight="230">
                                    <Canvas Width="100" Height="120">
                                        <Path Data="M10,4 H66 L90,28 V116 H10 Z" Stroke="{StaticResource Text}" StrokeThickness="5" StrokeLineJoin="Round"/>
                                        <Path Data="M66,4 V28 H90" Stroke="{StaticResource Text}" StrokeThickness="5" StrokeLineJoin="Round"/>
                                        <Path Data="M26,52 H74 M26,70 H74 M26,88 H58" Stroke="{StaticResource Muted}" StrokeThickness="6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    </Canvas>
                                </Viewbox>
                                <StackPanel Grid.Row="2" MinHeight="200" VerticalAlignment="Bottom">
                                    <TextBlock Text="{Binding Label}" FontSize="50" FontWeight="Bold" TextWrapping="Wrap" TextAlignment="Center"/>
                                    <TextBlock Text="{Binding Description}" FontSize="26" Foreground="{StaticResource Muted}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,12,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock x:Name="HintText" Grid.Row="2" FontSize="28" Foreground="{StaticResource Muted}" TextAlignment="Center"
                       TextWrapping="Wrap" Margin="0,16,0,0"
                       Text="Load the pages in the feeder, then tap a preset."/>
        </Grid>

        <!-- ============================== SCANNING ============================== -->
        <Grid x:Name="ScanView" Visibility="Collapsed">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="Scanning…" FontSize="72" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                <TextBlock x:Name="ScanPresetText" FontSize="34" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,12,0,0"/>
                <TextBlock x:Name="PageCountText" Text="Starting" FontSize="140" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,40,0,30"/>
                <ProgressBar IsIndeterminate="True" Height="14" Width="700" Foreground="{StaticResource Accent}" Background="{StaticResource Panel}" BorderThickness="0"/>
                <Button x:Name="CancelButton" Style="{StaticResource DangerButton}" HorizontalAlignment="Center" Margin="0,60,0,0" Click="Cancel_Click"><TextBlock Text="Cancel" Foreground="{StaticResource Danger}"/></Button>
            </StackPanel>
        </Grid>

        <!-- ============================== REVIEW ============================== -->
        <Grid x:Name="ReviewView" Visibility="Collapsed" Margin="48,36,48,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Margin="14,0,14,16">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="36" Height="36" Fill="{StaticResource Ok}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="ReviewTitle" Text="Saved" FontSize="58" FontWeight="SemiBold" Margin="20,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock x:Name="ReviewFileText" FontSize="28" Foreground="{StaticResource Muted}" Margin="56,8,0,0" TextTrimming="CharacterEllipsis"/>
            </StackPanel>

            <Border Grid.Row="1" CornerRadius="24" Background="{StaticResource Panel}" Padding="18">
                <ScrollViewer x:Name="ThumbScroll" VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly">
                    <ItemsControl x:Name="Thumbs">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="14">
                                    <Border Background="White" Padding="0" BorderBrush="#475569" BorderThickness="2">
                                        <Image Source="{Binding Image}" Height="300" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                    </Border>
                                    <TextBlock Text="{Binding Caption}" FontSize="22" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <Grid Grid.Row="2" Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="CountdownText" Grid.Column="0" FontSize="26" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="14,0" TextWrapping="Wrap"/>
                <Button Grid.Column="1" Style="{StaticResource DangerButton}" Click="Discard_Click"><TextBlock Text="Discard" Foreground="{StaticResource Danger}"/></Button>
                <Button Grid.Column="2" Style="{StaticResource ActionButton}" Click="AddPages_Click">+ Add more pages</Button>
                <Button Grid.Column="3" Style="{StaticResource PrimaryButton}" MinWidth="320" Click="Done_Click">Done</Button>
            </Grid>
        </Grid>

        <!-- ============================== MESSAGE ============================== -->
        <Grid x:Name="MessageView" Visibility="Collapsed" Background="#E60F172A">
            <Border CornerRadius="32" Background="{StaticResource Panel}" Padding="60,50" MaxWidth="1100"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock x:Name="MessageTitle" FontSize="54" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock x:Name="MessageBody" FontSize="32" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,24,0,40"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="MessageSecondary" Style="{StaticResource ActionButton}" Click="MessageSecondary_Click">Cancel</Button>
                        <Button x:Name="MessagePrimary" Style="{StaticResource PrimaryButton}" Click="MessagePrimary_Click">OK</Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Hidden exit: press and hold the top-left corner -->
        <Border x:Name="ExitHotspot" Width="110" Height="110" HorizontalAlignment="Left" VerticalAlignment="Top"
                Background="#01000000"
                PreviewMouseLeftButtonDown="Exit_Down" PreviewMouseLeftButtonUp="Exit_Up" MouseLeave="Exit_Up"/>
    </Grid>
</Window>
